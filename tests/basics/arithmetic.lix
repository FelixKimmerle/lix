print 1 + 2;            // expect: 3
print 10 - 3 - 2;       // expect: 5
print 2 + 3 * 4;        // expect: 14
print (2 + 3) * 4;      // expect: 20
print 7 / 2;            // expect: 3
print 7 % 3;            // expect: 1
print -7 / 2;           // expect: -3
print 7.0 / 2;          // expect: 3.5
print 1 + 0.5;          // expect: 1.5
print 0.5 + 1;          // expect: 1.5
print -(3 + 4);         // expect: -7
print 100 / 10 / 5;     // expect: 2
print 2.0 * 3.0;        // expect: 6.0
print 1e3;              // expect: 1000.0
print 0.1 + 0.2;        // expect: 0.3
print 9223372036854775807 + 1; // expect: -9223372036854775808
